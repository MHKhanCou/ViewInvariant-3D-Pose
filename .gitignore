# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Model weights and checkpoints
checkpoint/*.pth.tr
*.pt
yolov8*.pt

# Data (large files, not for git)
data/motion3d/
data/motion2d/
data/__MACOSX/
*.pkl
*.pkl.zip
*.npz
*.npy

# Output files
demo_live/output/
demo/output/
*.mp4
*.avi
*.mov
*.mkv

# Images (exclude everywhere except thesis_artifacts/figures/)
*.png
*.jpg
*.jpeg
*.gif
!thesis_artifacts/figures/*.png
!thesis_artifacts/figures/*.jpg

# Logs
*.log
wandb/
gradio_debug*.log
!thesis_artifacts/baseline_evaluation.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary
*.tmp
*.bak
*.orig

# LaTeX build products (the .tex, .pdf and images ARE tracked)
thesis_report/*.aux
thesis_report/*.out
thesis_report/*.toc
thesis_report/*.lof
thesis_report/*.lot
thesis_report/*.synctex.gz
thesis_report/*.fls
thesis_report/*.fdb_latexmk
# The report PDF and its figures are the deliverable, so override the global
# image and PDF rules for this directory only.
!thesis_report/Full_Thesis_Report.pdf
!thesis_report/images/*.png
!thesis_report/images/*.jpg

# Bulky/diagnostic artifacts (not defense evidence)
thesis_artifacts/rotation_analysis/
thesis_artifacts/rotation_test/
thesis_artifacts/diagnostic/
thesis_artifacts/diagnostic_v2/
thesis_artifacts/diagnostic_v3/
thesis_artifacts/app_log.txt
thesis_artifacts/benchmark/results/
