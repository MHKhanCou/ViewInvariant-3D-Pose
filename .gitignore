.idea/
.vscode/
*.swp
*.swo
*~

# Model weights and checkpoints
checkpoint/*.pth.tr
*.pt
yolov8*.pt

# Data (large files, not for git)
data/motion3d/
data/motion2d/
data/__MACOSX/
*.pkl
*.pkl.zip
*.npz
*.npy

# Output files
demo_live/output/
demo/output/
*.mp4
*.avi
